{
  "name": "aijbookmarks",
  "version": "3.1.0",
  "description": "AI-powered bookmark organizer Chrome extension",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
